<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.12</version>
    <relativePath/>
  </parent>

  <groupId>com.demie</groupId>
  <artifactId>portal-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Portal API</name>
  <description>Spring Boot 3 API for the Demie Client Portal</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>

    <!-- Local dev DB defaults, matching application.yml. Override on the
         command line, e.g. `./mvnw flyway:migrate -Ddb.name=portal_test`.
         Password intentionally omitted here; set it via the FLYWAY_PASSWORD
         / DB_PASSWORD env var instead of committing it. -->
    <db.host>localhost</db.host>
    <db.port>5432</db.port>
    <db.name>demie_portal</db.name>
    <db.username>postgres</db.username>
  </properties>

  <dependencies>
    <!-- Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JPA + Hikari + Flyway for schema -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>
    <!-- Flyway 9.22.3 (managed by Spring Boot 3.2.12) already supports
         PostgreSQL in flyway-core; the separate flyway-database-postgresql
         module is Flyway 10+ only and must not be mixed in. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- S3-compatible presigning (MinIO local, prod S3) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.25.16</version>
    </dependency>
    <!-- Apache HTTP client: referenced directly by S3Config, which wraps it to
         strip the "Expect: 100-continue" header the SDK adds to PutObject. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
      <version>2.25.16</version>
    </dependency>

    <!-- Security helpers: password hashing, random tokens -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Image resizing for derivative previews/thumbs (Task 7) -->
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.20</version>
    </dependency>
    <!-- TwelveMonkeys ImageIO plugin: registers the CMYK JPEG reader the JDK
         lacks, so CMYK JPEGs (photographer originals from print workflows)
         decode and resize instead of quarantining as failures. Picked up
         automatically via the ImageIO ServiceLoader. -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>3.10.1</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <version>9.22.3</version>
        <configuration>
          <!-- Phase 0: DB and S3 are manual local processes configured via env.
               Host/port/db/user default to local dev values from <properties>
               and can be overridden with -Ddb.host=... etc. The password is
               NOT set here; supply it via the FLYWAY_PASSWORD (or DB_PASSWORD)
               env var so it is never committed. -->
          <url>jdbc:postgresql://${db.host}:${db.port}/${db.name}</url>
          <user>${db.username}</user>
          <!-- Read from source so `flyway:migrate` reflects edits without a
               prior compile. Runtime Flyway uses classpath:db/migration. -->
          <locations>filesystem:src/main/resources/db/migration</locations>
          <cleanDisabled>false</cleanDisabled>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
