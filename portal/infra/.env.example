# Portal API + web local dev environment (Phase 0).
# Copy this file into your shell profile or a local .env and fill in real
# values; never commit secrets.

# ---------------------------------------------------------------------------
# Database (Postgres 16, manual local process)
# ---------------------------------------------------------------------------
# The API builds the JDBC URL from these; defaults target local dev.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demie_portal
DB_USERNAME=postgres
# Dev-only default. Replace in any shared/prod environment.
DB_PASSWORD=change-me

# Separate DB used by the test profile (application-test.yml).
TEST_DB_NAME=portal_test

# Flyway CLI/plugin (mvn flyway:migrate) reads the password from this var so it
# is never committed to the pom or application.yml.
FLYWAY_PASSWORD=${DB_PASSWORD}

# ---------------------------------------------------------------------------
# Object storage (MinIO local / S3-compatible)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Bucket names used by the API. Local MinIO uses exactly these names; prod
# uses environment-scoped names (see buckets.md).
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_PREVIEWS=previews
S3_BUCKET_THUMBS=thumbs
S3_BUCKET_ZIPS=zips

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
