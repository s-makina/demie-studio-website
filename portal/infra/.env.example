# Portal API + web local dev environment (Phase 0).
# Copy this file into your shell profile or a local .env and fill in real
# values; never commit secrets.
#
# This file has two readers, so keep it to plain KEY=value lines:
#   - Spring Boot, which imports it whenever the "local" profile is active
#     (api/src/main/resources/application-local.yml)
#   - shell scripts, which source the S3_* lines (scripts/upload-fixture.sh)
# That means: no surrounding quotes and no shell expansion in values. Quoting
# would be taken literally, so `KEY='x'` would give Spring the value "'x'". If a
# value needs quotes or a backslash, export it as a real environment variable
# instead - environment variables override this file.

# ---------------------------------------------------------------------------
# Database (Postgres 16, manual local process)
# ---------------------------------------------------------------------------
# The API builds the JDBC URL from these; defaults target local dev.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demie_portal
DB_USERNAME=postgres
# Dev-only default. Replace in any shared/prod environment.
DB_PASSWORD=change-me

# Separate DB used by the test profile (application-test.yml).
TEST_DB_NAME=portal_test

# Flyway CLI/plugin (mvn flyway:migrate) reads the password from this var so it
# is never committed to the pom or application.yml. Shell-only: the expansion
# resolves when a shell sources this file. Spring stores the literal string and
# nothing reads it, so the two readers do not conflict.
FLYWAY_PASSWORD=${DB_PASSWORD}

# ---------------------------------------------------------------------------
# Object storage (Dokploy MinIO, S3-compatible)
# ---------------------------------------------------------------------------
# S3 API domain (Traefik -> MinIO port 9000). The web console lives on a
# separate domain (-> port 9001); never use the console domain here or every
# S3 call fails with "S3 API Requests must be made to API port."
S3_ENDPOINT=http://salvation-minio-7c8f86-102-202-45-205.sslip.io
# Service-account credentials. Fill from Dokploy / MinIO console; never commit
# real values in this file — put them in infra/.env (gitignored) instead.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Bucket names used by the API. Single-bucket mode: all four classes share
# `demie-studio`, separated by key prefix (originals/, previews/, thumbs/,
# zips/). Split per class via env if buckets ever diverge.
S3_BUCKET_ORIGINALS=demie-studio
S3_BUCKET_PREVIEWS=demie-studio
S3_BUCKET_THUMBS=demie-studio
S3_BUCKET_ZIPS=demie-studio

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
