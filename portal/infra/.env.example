# Portal API + web local dev environment (Phase 0).
# Copy this file and fill in real values; never commit secrets.

# ---------------------------------------------------------------------------
# Database (Postgres 16, manual local process)
# ---------------------------------------------------------------------------
# JDBC URL for the main portal DB. The Flyway migration creates all tables.
DATABASE_URL=jdbc:postgresql://localhost:5432/portal?user=postgres&password=postgres

# Optional separate DB used by some tests / integration tests.
# DATABASE_TEST_URL=jdbc:postgresql://localhost:5432/portal_test?user=postgres&password=postgres

# ---------------------------------------------------------------------------
# Object storage (MinIO local / S3-compatible)
# ---------------------------------------------------------------------------
# S3-compatible endpoint. Local MinIO example: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Bucket names used by the API. In this phase these are S3 prefixes; the API
# stores objects under e.g. originals/<project>/<media-id>/...
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_PREVIEWS=previews
S3_BUCKET_THUMBS=thumbs
S3_BUCKET_ZIPS=zips

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
# The web app calls the API through this base URL. Required at dev/build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Auth (Phase 1)
# ---------------------------------------------------------------------------
# Secret used to sign session/auth tokens. Rotate in prod.
# AUTH_SECRET=change-me
